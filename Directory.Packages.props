<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="ReactiveUI" Version="24.2.0" />
    <!--
      ReactiveUI.Avalonia 12.1.1 is the current stable Avalonia integration
      package. Its net10.0 dependency floor is Avalonia >= 12.1.1 and
      ReactiveUI >= 24.1.0, so Avalonia 12.1.2 + ReactiveUI 24.2.0 is inside
      the package's published compatibility range.
    -->
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.1" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />

    <!--
      #15 bounded presentation spike only. CommunityToolkit.Mvvm is consumed
      by Zapret2Pilot.App.ViewModelTests with PrivateAssets=all; production
      projects remain ReactiveUI-only while the alternative is evaluated.
    -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!--
      Analyzer packages remain on their existing major lines for #15.
      Analyzer-major migration is not required to service the runtime/UI
      stack and would change diagnostics independently of the compatibility
      spike; drift is recorded in the #15 evidence instead.
    -->
    <PackageVersion Include="Meziantou.Analyzer" Version="2.0.189" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />

    <!--
      Test framework packages remain on the proven v3 cohort for #15.
      xUnit v4 is a separate major migration and is recorded as intentional
      drift rather than being coupled to the presentation servicing change.
    -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!--
      FluentIcons.Avalonia 2.1.x is the Avalonia 12-aligned stable line.
      Keep it synchronized with the supported Avalonia 12 presentation
      baseline instead of retaining the earlier Avalonia 11-era 2.0 line.
    -->
    <PackageVersion Include="FluentIcons.Avalonia" Version="2.1.339.1" />
  </ItemGroup>
</Project>
