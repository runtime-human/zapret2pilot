<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    <PackageVersion Include="ReactiveUI" Version="23.2.28" />
    <!--
      ReactiveUI.Avalonia 12.0.5 is NOT published on NuGet. The latest 12.x
      release is 12.0.3 (which targets Avalonia 12.0.4 and ReactiveUI
      23.2.28, matching our stack). The next published version, 14.7.1,
      depends on Avalonia 11.0.0 and ReactiveUI 19.4.1, which is
      incompatible with our Avalonia 12.0.5 / ReactiveUI 23.2.28 stack.
      Decision: keep ReactiveUI.Avalonia at 12.0.3 (nearest known stable
      version that targets Avalonia 12.x). Avalonia 12.0.3 -> 12.0.5 is
      a patch-level bump and is covered by the Avalonia package itself.
    -->
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.0.3" />
    <PackageVersion Include="System.Reactive" Version="6.1.0" />

    <!--
      Meziantou.Analyzer and Roslynator.Analyzers (0.0.18-C / D-A1, D-A2).
      Wired repo-wide in Directory.Build.props with PrivateAssets="all".
      Severity is phased via .editorconfig: starts as "suggestion",
      will be ramped to "warning" in a later milestone.
    -->
    <PackageVersion Include="Meziantou.Analyzer" Version="2.0.189" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!--
      FluentIcons.Avalonia: pinned to the exact version that was
      verified compatible with the Avalonia 12.0.5 / ReactiveUI
      23.2.28 stack. See DEC-0051 in docs/Z2P-DECISION-LOG.md.
    -->
    <PackageVersion Include="FluentIcons.Avalonia" Version="2.0.316.1" />
  </ItemGroup>
</Project>
