<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Zapret2Pilot.App.Tests</AssemblyName>
    <RootNamespace>Zapret2Pilot.App.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      0.0.28 Packet 3: match the Windows TFM of Zapret2Pilot.App and
      Zapret2Pilot.Runtime, which this project exercises. The TFM is
      a superset of net10.0, so cross-platform assemblies (Core,
      Application, Engine.Zapret2, Storage) keep loading at test
      time and the architecture tests can assert the platform split.
    -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zapret2Pilot.App\Zapret2Pilot.App.csproj" />
  </ItemGroup>
</Project>
