<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Zapret2Pilot.Testing.BrokerCrashHost</AssemblyName>
    <RootNamespace>Zapret2Pilot.Testing.BrokerCrashHost</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
