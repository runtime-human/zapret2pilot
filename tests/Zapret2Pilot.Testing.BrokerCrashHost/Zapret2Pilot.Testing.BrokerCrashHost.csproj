  <ItemGroup>
    <ProjectReference Include="..\..\src\Zapret2Pilot.Broker\Zapret2Pilot.Broker.csproj" />
    <ProjectReference Include="..\..\src\Zapret2Pilot.Contracts\Zapret2Pilot.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Zapret2Pilot.Runtime\Zapret2Pilot.Runtime.csproj" />
    <ProjectReference Include="..\..\src\Zapret2Pilot.Engine.Zapret2\Zapret2Pilot.Engine.Zapret2.csproj" />
    <ProjectReference Include="..\..\src\Zapret2Pilot.Infrastructure\Zapret2Pilot.Infrastructure.csproj" />
    <ProjectReference Include="..\Zapret2Pilot.Testing.FakeRuntime\Zapret2Pilot.Testing.FakeRuntime.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
