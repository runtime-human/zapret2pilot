<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Zapret2Pilot.Runtime.Tests</AssemblyName>
    <RootNamespace>Zapret2Pilot.Runtime.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      0.0.25 Scope C: match the Windows TFM of Zapret2Pilot.Runtime,
      which this project exercises. The TFM is a superset of net10.0
      so the cross-platform FakeRuntime test executable (which stays
      on net10.0) keeps resolving as a transitive dependency.
    -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zapret2Pilot.Runtime\Zapret2Pilot.Runtime.csproj" />
    <!--
      Reference the FakeRuntime test executable so its .exe and .dll are
      copied next to the test assembly. Used by the 0.0.17 host integration
      test that launches the fake runtime in place of winws2. Marked
      PrivateAssets="all" so the fake does not become a transitive
      dependency of anything that consumes the test assembly.
    -->
    <ProjectReference Include="..\Zapret2Pilot.Testing.FakeRuntime\Zapret2Pilot.Testing.FakeRuntime.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
