<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!--
      #15 dependency determinism: every PackageReference project generates a
      versioned packages.lock.json. CI switches to locked mode once the
      servicing graph produced by this spike is committed.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!--
      .NET 10 audits transitive dependencies by default; keep the intent
      explicit and make every NU1901-NU1904 advisory a restore blocker.
      There are no blanket audit suppressions in the supported baseline.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>

    <RepositoryUrl>https://github.com/MrFr3di/zapret2pilot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Zapret2Pilot contributors</Authors>
    <Company>Zapret2Pilot</Company>
    <Product>Zapret2Pilot</Product>
    <Copyright>Copyright © Zapret2Pilot contributors</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <Z2PVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Z2PVersion>
    <Version>$(Z2PVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Analyzer packages (0.0.18-C / D-A1, D-A2).
      Wired repo-wide. Severity is phased via .editorconfig: starts as
      "suggestion", will be ramped to "warning" in a later milestone.
      PrivateAssets="all" keeps these analyzers from leaking to consumers.
    -->
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
