<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Zapret2Pilot.Application</AssemblyName>
    <RootNamespace>Zapret2Pilot.Application</RootNamespace>
    <Description>Application orchestration skeleton for Zapret2Pilot.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zapret2Pilot.Core\Zapret2Pilot.Core.csproj" />
  </ItemGroup>

  <!--
    Microsoft.Extensions.Hosting is used here only to expose
    IServiceCollection / AddSingleton for the typed use-case facades
    introduced in 0.0.25 Packet 2 (Scope E). The Application layer
    does not host any IHostedService itself; the actual host lives
    in Zapret2Pilot.App. The package is centrally pinned in
    Directory.Packages.props (10.0.9) and shared with App and
    Runtime.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
</Project>
