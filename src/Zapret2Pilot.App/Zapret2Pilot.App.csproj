<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>z2p</AssemblyName>
    <RootNamespace>Zapret2Pilot.App</RootNamespace>
    <Description>Avalonia shell for Zapret2Pilot.</Description>
    <!--
      0.0.25 Scope C: platform boundary. The Avalonia shell is a
      Windows-only application (composes Win32, Job Objects, winws2),
      so it is built on a Windows-specific TFM. Cross-platform layers
      (Core/Application/Engine/Storage) stay on net10.0 and are
      verified by tests/Zapret2Pilot.App.ViewModelTests/Architecture.
    -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="FluentIcons.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="ReactiveUI.Avalonia" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zapret2Pilot.Application\Zapret2Pilot.Application.csproj" />
    <ProjectReference Include="..\Zapret2Pilot.Runtime\Zapret2Pilot.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
