<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>z2p</AssemblyName>
    <RootNamespace>Zapret2Pilot.App</RootNamespace>
    <Description>Avalonia shell for Zapret2Pilot.</Description>
    <!--
      v7 Control Plane boundary. The Avalonia shell is a Windows-only
      application, but privileged runtime/process authority belongs to
      z2p-broker.exe. Cross-platform layers stay on net10.0 and the App
      consumes shared broker contracts rather than Runtime implementation.
    -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <!--
      CA1848 (LoggerMessage source generator) and CA1873 (expensive
      logging arguments) are suppressed at the project level. The
      App layer's first structured logger
      (ILogger<Z2PApplicationLifecycleCoordinator>, added in 0.0.28
      Packet 3 P0-9) is used in best-effort startup paths where
      allocation-free logging is not a concern, and the arguments it
      captures are already-resolved phase names / error codes
      rather than freshly-allocated strings. Migrating to
      LoggerMessage source generators is tracked separately and is
      out of scope for 0.0.28. The same suppression is applied
      project-wide in the Runtime project for the same reason.
    -->
    <NoWarn>$(NoWarn);CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <!--
    ReactiveUI 24's System.Reactive-compatible distribution recompiles
    seam APIs under ReactiveUI.Reactive / ReactiveUI.Avalonia.Reactive.
    Keep those namespaces presentation-local and global for this project
    so the existing shell source composes with the supported .Reactive
    family without leaking presentation concerns into lower layers.
  -->
  <ItemGroup>
    <Using Include="ReactiveUI.Reactive" />
    <Using Include="ReactiveUI.Avalonia.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="FluentIcons.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="ReactiveUI.Reactive" />
    <PackageReference Include="ReactiveUI.Avalonia.Reactive" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zapret2Pilot.Contracts\Zapret2Pilot.Contracts.csproj" />
    <ProjectReference Include="..\Zapret2Pilot.Application\Zapret2Pilot.Application.csproj" />
    <!-- General application SQLite remains owned by the unelevated
         Control Plane. This explicit reference is intentionally
         independent from the privileged Runtime Broker. -->
    <ProjectReference Include="..\Zapret2Pilot.Storage\Zapret2Pilot.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
