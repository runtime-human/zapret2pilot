<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <SolidColorBrush x:Key="Z2P.Brush.Background" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Z2P.Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Z2P.Brush.Sidebar" Color="#EEF2F7" />
    <SolidColorBrush x:Key="Z2P.Brush.Border" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Z2P.Brush.Primary" Color="#2563EB" />
    <SolidColorBrush x:Key="Z2P.Brush.Success" Color="#16A34A" />
    <SolidColorBrush x:Key="Z2P.Brush.TextPrimary" Color="#0F172A" />
    <SolidColorBrush x:Key="Z2P.Brush.TextSecondary" Color="#475569" />
    <SolidColorBrush x:Key="Z2P.Brush.TextMuted" Color="#64748B" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial" />
    <Setter Property="Background" Value="{StaticResource Z2P.Brush.Background}" />
  </Style>

  <Style Selector="Border.Card">
    <Setter Property="Background" Value="{StaticResource Z2P.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Z2P.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <Style Selector="Border.Sidebar">
    <Setter Property="Background" Value="{StaticResource Z2P.Brush.Sidebar}" />
    <Setter Property="BorderBrush" Value="{StaticResource Z2P.Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Border.NavItem">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="TextBlock.PageTitle">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Z2P.Brush.TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.CardTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Z2P.Brush.TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.Body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Z2P.Brush.TextSecondary}" />
  </Style>

  <Style Selector="TextBlock.Muted">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Z2P.Brush.TextMuted}" />
  </Style>
</Styles>
